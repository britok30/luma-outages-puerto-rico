NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
CENSUS_API_KEY=your_census_api_key
# Neon Postgres connection string (pooled), enables outage history
DATABASE_URL=postgres://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Shared secret for /api/cron/snapshot (any long random string)
CRON_SECRET=change-me
